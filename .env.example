# Copy to .env and set the keys for the backends you run.
# `npm run eval` reads .env when it exists.

# Laya: a System One server you run yourself (see README).
LAYA_BASE_URL=http://127.0.0.1:8000
# LAYA_API_KEY=      # only when the server sets LAYA_API_KEY itself
# LAYA_MODEL=        # english, multilingual, or typed-decisions; empty routes by language

# Jev: TypeSafe's hosted System One API.
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest

# Claude: the Claude API, with structured outputs.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
